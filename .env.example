# Copia este archivo como .env.local y completa tus datos.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Publishable key (empieza por sb_publishable_). Si tu proyecto usa las llaves antiguas, pon aquí la "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Ajustes regionales (opcionales) ---
NEXT_PUBLIC_CURRENCY=COP
NEXT_PUBLIC_CURRENCY_DECIMALS=0
NEXT_PUBLIC_LOCALE=es-CO
NEXT_PUBLIC_TIME_ZONE=America/Bogota
